{
  "mcpServers": {
    "angular-cli": {
      "command": "npx",
      "args": ["-y", "@angular/cli", "mcp", "--read-only"]
    },
    "microsoft-learn": {
      "type": "http",
      "url": "https://learn.microsoft.com/api/mcp"
    },
    "bicep": {
      "command": "dnx",
      "args": ["-y", "Azure.Bicep.McpServer"]
    }
  }
}
